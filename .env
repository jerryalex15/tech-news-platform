# PORT
SERVER_NEWS_SERVICE_PORT=8081
# DB
DB_NEWS_NAME=tech-news-db
DB_HOST=postgres
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=secret
# JPA
JPA_DDL_AUTO=validate
#KAFKA
KAFKA_BOOTSTRAP_SERVERS: kafka:29092
#JWT
PRIVATE_KEY_PATH=/secrets/private_key.pem
PUBLIC_KEY_PATH=/secrets/public_key.pem
#EXTERNAL_API
DEVTO_API_TAG: ${DEVTO_API_TAG:-java}